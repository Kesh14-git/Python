#Simple example without exception handling
a = 10
b = 0
print(a/b)

# with exception handling
a = 10
b = 0
try:
    print(a / b)
except ZeroDivisionError:
    print("Cannot divide by zero")

#try and except block
try:
    a = 10
    b = 0
    print(a / b)
except:
    print("An error occured")

#Handling a specific exception
try:
    num = 10
    result = num / 0
except ZeroDivisionError:
