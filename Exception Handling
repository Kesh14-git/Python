#Catching multiple Exceptions in one

try:
    num = int(input("Enter number:"))
    result = 10 / num
except (ValueError, ZeroDivisionError):
    print("Invalid input or division by zero")

#Using as with exception
try:
    num = 10 / 0
except ZeroDivisionError as e:
    print("Error:", e)

try:
    number = int("abc")
except ValueError as e:
    print("Error:", e)

#Generic Exception Handling

try:
    a = 10
    b = 0
    print(a / b)
except Exception as e:
    print("Error:", e)

#Raise with try except

try:
    age = 15
    if age < 18:
        raise ValueError("Not eligible to vote")
except ValueError as e:
    print(e)

#Custom Exceptions
class AgeError(Exception):
    pass
age = 15
try:
    if age < 18:
        raise AgeError("Age must be 18 or above")
except AgeError as e:
    print(e)

#Custom EXception With Customer
class InsufficentBalanceError(Exception):
    def __init__(self, message):
        self.message = message
        super(). __init__(self.message)
balance = 1000
withdraw = 15000

try:
    if withdraw > balance:
        raise InsufficentBalanceError("Insufficient balance")
except InsufficientBalanceError as e:
    print(e)

